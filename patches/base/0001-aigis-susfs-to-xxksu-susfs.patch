 #include <linux/susfs_ksu.h>
 extern struct static_key_true ksu_is_init_rc_hook_enabled;
 #endif
@@ -599,7 +599,7 @@ SYSCALL_DEFINE3(read, unsigned int, fd, char __user *, buf, size_t, count)
 	ssize_t ret = -EBADF;
 
 
-#ifdef CONFIG_KSU
