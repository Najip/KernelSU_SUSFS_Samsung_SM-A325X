diff --git a/Kconfig b/Kconfig
index 8417b8778..c5032140f 100644
--- a/Kconfig
+++ b/Kconfig
@@ -11,6 +11,15 @@ config SRCARCH
 
 source "arch/$SRCARCH/Kconfig"
 
+config XXKSU_HOOKLESS
+	def_bool y
+	depends on KSU=y
+	depends on KSU_TAMPER_SYSCALL_TABLE || KSU_HACK_ARM64_BRANCH_LINK
+	help
+	  Set when xxKSU hooks reboot, execve, faccessat, newfstatat, newfstat
+	  and read itself (syscall table or ARM64 branch-link). The parent
+	  kernel then skips its own calls for those, so nothing runs twice.
+
 config XXKSU_MANUAL_HOOKS
 	bool "xxKSU direct parent-kernel hooks"
 	depends on KSU=y
