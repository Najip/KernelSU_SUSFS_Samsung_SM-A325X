diff --git a/fs/open.c b/fs/open.c
index 4dc4d73d6..cecbe596c 100644
--- a/fs/open.c
+++ b/fs/open.c
@@ -429,10 +429,12 @@ retry:
 	if (likely(susfs_is_current_proc_no_su()))
 		goto orig_flow;
 
+#ifndef CONFIG_XXKSU_HOOKLESS
 	if (static_branch_likely(&ksu_su_compat_enabled)) {
 		if (unlikely(__ksu_is_allow_uid_for_current(current_uid().val)))
 			ksu_handle_faccessat(&dfd, &fname, &mode, NULL);
 	}
+#endif
 
 orig_flow:
 	res = filename_lookup(dfd, fname, lookup_flags, &path, NULL);
diff --git a/fs/stat.c b/fs/stat.c
index 85ca41b29..474c666e8 100644
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -236,10 +236,12 @@ retry:
 	if (likely(susfs_is_current_proc_no_su()))
 		goto orig_flow;
 
+#ifndef CONFIG_XXKSU_HOOKLESS
 	if (static_branch_likely(&ksu_su_compat_enabled)) {
 		if (unlikely(__ksu_is_allow_uid_for_current(current_uid().val)))
 			ksu_handle_stat(&dfd, &fname, &flags);
 	}
+#endif
 
 orig_flow:
 	error = filename_lookup(dfd, fname, lookup_flags, &path, NULL);
@@ -435,7 +437,7 @@ SYSCALL_DEFINE2(newfstat, unsigned int, fd, struct stat __user *, statbuf)
 
 	if (!error)
 		error = cp_new_stat(&stat, statbuf);
-#ifdef CONFIG_XXKSU_MANUAL_HOOKS
+#if defined(CONFIG_XXKSU_MANUAL_HOOKS) && !defined(CONFIG_XXKSU_HOOKLESS)
 	/* xxKSU: report init.rc size including the injected KernelSU rc lines. */
 	ksu_handle_newfstat_ret(&fd, &statbuf);
 #endif
@@ -558,7 +560,7 @@ SYSCALL_DEFINE2(fstat64, unsigned long, fd, struct stat64 __user *, statbuf)
 
 	if (!error)
 		error = cp_new_stat64(&stat, statbuf);
-#ifdef CONFIG_XXKSU_MANUAL_HOOKS
+#if defined(CONFIG_XXKSU_MANUAL_HOOKS) && !defined(CONFIG_XXKSU_HOOKLESS)
 	/* xxKSU: same init.rc size fix for a 32-bit init. */
 	ksu_handle_fstat64_ret(&fd, &statbuf);
 #endif
diff --git a/fs/susfs_ksu_glue.c b/fs/susfs_ksu_glue.c
index 9e971ffc0..cb68ee0f0 100644
--- a/fs/susfs_ksu_glue.c
+++ b/fs/susfs_ksu_glue.c
@@ -84,7 +84,12 @@ int susfs_ksu_sys_reboot(int magic1, int magic2, unsigned int cmd, void __user *
             return 0;
         return susfs_ksu_handle_cmd(cmd, arg);
     }
+#ifdef CONFIG_XXKSU_HOOKLESS
+    /* xxKSU hooks sys_reboot itself and has already handled this call. */
+    return 0;
+#else
     return ksu_handle_sys_reboot(magic1, magic2, cmd, arg);
+#endif
 }
 
 static int __init susfs_ksu_glue_init(void)
