# Merged after the kernel tree's own fragments. Everything here is already set
# by ksu-a325n-common.config / mt6768_slm_defconfig; it is listed again so the
# build fails loudly if an upstream change ever drops one of these.

# xxKSU. The hook style (manual / syscall_table / branch_link) is set by
# configs/hooks/<style>.config, merged after this file.
CONFIG_KSU=y
CONFIG_XXKSU_MANUAL_HOOKS=y
# CONFIG_KSU_LSM_SECURITY_HOOKS is not set
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# SUSFS (JackA1ltman core)
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER=y

# LumiROM and other ports use EROFS for system/vendor
CONFIG_EROFS_FS=y
