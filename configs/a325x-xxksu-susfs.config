# Merged on top of a32_defconfig for every build.
CONFIG_LOCALVERSION="-xxKSU-SUSFS"
# CONFIG_LOCALVERSION_AUTO is not set

# Samsung hypervisor / kernel protection that blocks root
# CONFIG_UH is not set
# CONFIG_UH_RKP is not set
# CONFIG_RUSTUH_RKP is not set
# CONFIG_RUSTUH_KDP is not set
# CONFIG_RUSTUH_KDP_CRED is not set
# CONFIG_RUSTUH_KDP_NS is not set
# CONFIG_KDP_CRED is not set
# CONFIG_KDP_NS is not set
# CONFIG_SECURITY_DEFEX is not set
# CONFIG_PROCA is not set
# CONFIG_PROCA_S_OS is not set
# CONFIG_SECURITY_DSMS is not set
# CONFIG_INTEGRITY is not set
# CONFIG_KNOX_NCM is not set

# xxKSU (manual hooks only)
CONFIG_KSU=y
CONFIG_XXKSU_MANUAL_HOOKS=y
# CONFIG_KSU_LSM_SECURITY_HOOKS is not set
# CONFIG_KSU_HACK_ARM64_BRANCH_LINK is not set
# CONFIG_KSU_TAMPER_SYSCALL_TABLE is not set
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_TMPFS_XATTR=y

# SUSFS (JackA1ltman patch)
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER=y
