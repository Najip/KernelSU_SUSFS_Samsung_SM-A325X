# Hook style "syscall_table": xxKSU swaps the sys_call_table entries for
# reboot, execve, execveat, faccessat, newfstatat (and newfstat/read during
# boot) with its own wrappers. The kernel's duplicate calls are skipped by
# patches/hooks/0001-hookless-skip-parent-hooks.patch.
CONFIG_KSU_TAMPER_SYSCALL_TABLE=y
# CONFIG_KSU_HACK_ARM64_BRANCH_LINK is not set
CONFIG_XXKSU_HOOKLESS=y
