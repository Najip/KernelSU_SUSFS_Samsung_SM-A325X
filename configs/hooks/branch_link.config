# Hook style "branch_link": xxKSU starts with the syscall table hooks, then
# shortly after init.rc is handled rewrites the "bl" instructions inside sys_faccessat,
# sys_newfstatat and sys_execve to jump straight to its handlers and drops
# the table hook for each one that worked (kept for any that did not).
# The kernel's duplicate calls are skipped as for syscall_table.
CONFIG_KSU_HACK_ARM64_BRANCH_LINK=y
# CONFIG_KSU_TAMPER_SYSCALL_TABLE is not set
CONFIG_XXKSU_HOOKLESS=y
CONFIG_KALLSYMS=y
