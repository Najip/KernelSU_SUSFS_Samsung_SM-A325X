# BakaSU builds: merged after the kernel tree's own fragments.
# Everything here is already set by bakasu-aigis.config; it is listed again
# so the build fails loudly if an upstream change ever drops one of these.

# BakaSU with the SUSFS inline hooks (the only hook mode that works with SUSFS)
CONFIG_KSU=y
# CONFIG_KSU_MANUAL_HOOK is not set
# CONFIG_KSU_TRACEPOINT_HOOK is not set
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# SUSFS (JackA1ltman core)
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER=y

# LumiROM and other ports use EROFS for system/vendor
CONFIG_EROFS_FS=y
